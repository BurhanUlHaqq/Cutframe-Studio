# Docker ports and shared storage
STUDIO_PORT=5031
STUDIO_API_PORT=5032
STUDIO_DATA_PATH=D:/volumes/Cutframe

# Ranking provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# For an OpenAI-compatible provider, set LLM_PROVIDER=compatible.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=
# LLM_API_KEY=

# Local transcription
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
